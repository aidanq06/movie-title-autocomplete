if(NOT DEFINED APP OR NOT DEFINED DATA)
    message(FATAL_ERROR "APP and DATA are required")
endif()

function(run_cli expected_code)
    execute_process(COMMAND "${APP}" ${ARGN}
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${code}" STREQUAL "${expected_code}")
        message(FATAL_ERROR "Unexpected exit ${code}, expected ${expected_code}: ${output}${error}")
    endif()
    set(output "${output}" PARENT_SCOPE)
    set(error "${error}" PARENT_SCOPE)
endfunction()

function(require_text haystack needle)
    string(FIND "${haystack}" "${needle}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Missing text: ${needle}\nActual output: ${haystack}")
    endif()
endfunction()

run_cli(0 --help)
require_text("${output}" "Usage:")
run_cli(0)
require_text("${output}" "--data PATH")
run_cli(0 --data "${DATA}" --search "star light")
require_text("${output}" "Loaded records: 22")
require_text("${output}" "Source rows scanned: 29")
require_text("${output}" "Malformed rows skipped: 1")
set(expected "Matches: 5\n  STAR LIGHT (1999) [tt0000006]\n  Star Light (Unknown year) [tt0000004]\n  Star Light (2001) [tt0000005]\n  Star Light (2001) [tt0000008]\n  Star-Light (Unknown year) [tt0000007]\nNodes visited: 11\n")
require_text("${output}" "${expected}")
set(first_output "${output}")
run_cli(0 --data "${DATA}" --search "star light")
if(NOT output STREQUAL first_output)
    message(FATAL_ERROR "CLI results are not deterministic")
endif()
run_cli(0 --data "${DATA}" --search star)
require_text("${output}" "Matches: 10")
run_cli(0 --data "${DATA}" --search "a title that does not exist")
require_text("${output}" "Matches: 0")
run_cli(0 --data "${DATA}" --search "!!!")
require_text("${output}" "Matches: 0\nNodes visited: 0")
run_cli(0 --data "${DATA}" --max-movies 4 --search star)
require_text("${output}" "Loaded records: 4")
run_cli(0 --data "${DATA}" --max-movies 0)
require_text("${output}" "Loaded records: 0")
require_text("${output}" "Supply --search PREFIX")
run_cli(2 --search star)
require_text("${error}" "--data PATH is required")
run_cli(2 --unknown)
require_text("${error}" "Unknown option")
run_cli(2 --data)
require_text("${error}" "Missing value")
foreach(invalid -1 abc 1.5 +4 999999999999999999999999999999)
    run_cli(2 --data "${DATA}" --max-movies "${invalid}")
    require_text("${error}" "--max-movies")
endforeach()
run_cli(1 --data "${DATA}/missing.tsv")
require_text("${error}" "Cannot open IMDb TSV")
