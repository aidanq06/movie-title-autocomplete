if(NOT DEFINED APP OR NOT DEFINED DATA)
    message(FATAL_ERROR "APP and DATA are required")
endif()

function(run_cli expected_code)
    execute_process(COMMAND "${APP}" ${ARGN}
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${code}" STREQUAL "${expected_code}")
        message(FATAL_ERROR "Unexpected exit ${code}, expected ${expected_code}: ${output}${error}")
    endif()
    set(output "${output}" PARENT_SCOPE)
    set(error "${error}" PARENT_SCOPE)
endfunction()

function(require_text haystack needle)
    string(FIND "${haystack}" "${needle}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Missing text: ${needle}\nActual output: ${haystack}")
    endif()
endfunction()

function(forbid_text haystack needle)
    string(FIND "${haystack}" "${needle}" position)
    if(NOT position EQUAL -1)
        message(FATAL_ERROR "Unexpected text: ${needle}\nActual output: ${haystack}")
    endif()
endfunction()

# Runs the interactive menu with scripted input. Always supplies stdin, so a menu
# bug shows up as a failed check instead of a test waiting for a keyboard.
function(run_menu expected_code input_file)
    execute_process(COMMAND "${APP}" ${ARGN}
        INPUT_FILE "${input_file}"
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${code}" STREQUAL "${expected_code}")
        message(FATAL_ERROR "Unexpected exit ${code}, expected ${expected_code}: ${output}${error}")
    endif()
    set(output "${output}" PARENT_SCOPE)
    set(error "${error}" PARENT_SCOPE)
endfunction()

run_cli(0 --help)
