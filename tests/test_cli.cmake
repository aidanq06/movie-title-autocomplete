require_text("${output}" "Matches: 0")
require_text("${output}" "Results match: yes")
run_cli(0 --data "${WORK_DIR}/header_only.tsv")
require_text("${output}" "nothing to search")
file(WRITE "${WORK_DIR}/bad_header.tsv" "not\tthe\tright\tcolumns\n")
run_cli(1 --data "${WORK_DIR}/bad_header.tsv")
require_text("${error}" "Malformed IMDb TSV header")

