# --algorithm: each choice reports its own structure, with the same results.
set(star_light "Matches: 5\n  STAR LIGHT (1999) [tt0000006]\n  Star Light (Unknown year) [tt0000004]\n  Star Light (2001) [tt0000005]\n  Star Light (2001) [tt0000008]\n  Star-Light (Unknown year) [tt0000007]\n")
run_cli(0 --data "${DATA}" --search "star light" --algorithm trie)
require_text("${output}" "Trie nodes: 75")
require_text("${output}" "${star_light}Nodes visited: 11\n")
forbid_text("${output}" "Ternary Search Tree")
run_cli(0 --data "${DATA}" --search "star light" --algorithm tst)
require_text("${output}" "Ternary Search Tree nodes: 74")
require_text("${output}" "${star_light}Nodes visited: 12\n")
forbid_text("${output}" "Trie nodes")
run_cli(0 --algorithm both --search "STAR-LIGHT!" --data "${DATA}")
require_text("${output}" "Trie nodes: 75")
require_text("${output}" "Ternary Search Tree nodes: 74")
require_text("${output}" "[Trie]\n${star_light}")
require_text("${output}" "[Ternary Search Tree]\n${star_light}")
require_text("${output}" "Results match: yes")
run_cli(0 --data "${DATA}" --search "no such movie" --algorithm both)
require_text("${output}" "Matches: 0")
require_text("${output}" "Results match: yes")
run_cli(0 --data "${DATA}" --search "!!!" --algorithm tst)
require_text("${output}" "Matches: 0\nNodes visited: 0")

# Invalid combinations are rejected before any file is read.
run_cli(2 --data "${DATA}" --search star --algorithm btree)
require_text("${error}" "--algorithm must be trie, tst, or both")
run_cli(2 --data "${DATA}" --algorithm tst)
require_text("${error}" "--algorithm only applies to --search")
run_cli(2 --data "${DATA}" --search star --benchmark)
require_text("${error}" "cannot be used together")
run_cli(2 --data "${DATA}" --csv out.csv)
require_text("${error}" "--csv only applies to --benchmark")
run_cli(2 --benchmark)
require_text("${error}" "--data PATH is required")
run_cli(0 --help)
require_text("${output}" "--algorithm")
require_text("${output}" "--benchmark")

# --benchmark on the small fixture: correct results, but it warns about the size.
if(NOT DEFINED WORK_DIR)
    message(FATAL_ERROR "WORK_DIR is required")
endif()
file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}")
set(csv "${WORK_DIR}/nested/queries.csv")
run_cli(0 --data "${DATA}" --benchmark --csv "${csv}")
require_text("${output}" "BENCHMARK RESULTS")
require_text("${output}" "Construction time")
require_text("${output}" "Estimated index memory")
require_text("${output}" "Median query time")
require_text("${output}" "Correctness checks: PASSED")
require_text("${output}" "WARNING: this dataset only produced")
if(NOT EXISTS "${csv}")
    message(FATAL_ERROR "Benchmark did not write ${csv}")
endif()
file(READ "${csv}" csv_text)
require_text("${csv_text}" "prefix,category,limit,total_matches,algorithm,")
require_text("${csv_text}" "Ternary Search Tree")
forbid_text("${csv_text}" ",false\n")
# A file where a directory is needed makes the CSV path unwritable.
file(WRITE "${WORK_DIR}/blocker" "x")
run_cli(1 --data "${DATA}" --benchmark --csv "${WORK_DIR}/blocker/queries.csv")
require_text("${error}" "Error:")

# Invalid and empty datasets fail clearly in every mode, without crashing.
run_cli(1 --data "${DATA}/missing.tsv" --benchmark)
require_text("${error}" "Cannot open IMDb TSV")
run_cli(1 --data "${DATA}/missing.tsv" --search star --algorithm both)
require_text("${error}" "Cannot open IMDb TSV")
file(WRITE "${WORK_DIR}/header_only.tsv" "tconst\ttitleType\tprimaryTitle\tisAdult\tstartYear\n")
run_cli(1 --data "${WORK_DIR}/header_only.tsv" --benchmark)
